# Copy this file to .env and set each value in your local or deployment secret
# store. Never commit .env or place production values in this file.

# CockroachDB connection string and MCP bearer token.
DATABASE_URL=
MCP_SECRET_TOKEN=

# Server-owned embedding provider configuration. Provider credentials are
# required only for the selected provider.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
GEMINI_API_KEY=
AWS_REGION=
OPENAI_API_KEY=
OPENAI_BASE_URL=